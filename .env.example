PORT=5174

# ------------------------------------------------------------
# Frontend-only contact form (EmailJS) — NO BACKEND REQUIRED
#
# Create an EmailJS account, then set these values from your
# EmailJS dashboard (Service ID, Template ID, Public Key).
#
# In your EmailJS template, set the recipient (To) to your inbox
# OR use the optional `to_email` variable.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: recipient email if your EmailJS template uses {{to_email}}.
VITE_CONTACT_TO_EMAIL=kphuchuynh2005@gmail.com


# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=kphuchuynh2005@gmail.com
